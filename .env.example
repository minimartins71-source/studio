# Copie ce fichier en .env.local et remplis les valeurs.
# .env.local n'est jamais envoyé sur GitHub.

# Clé OpenAI : https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Supabase : Project Settings > API Keys
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Clé secrète Supabase : serveur uniquement, jamais dans le navigateur
SUPABASE_SECRET_KEY=
